{
  "type": "module",
  "version": "2.3.4",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:debug": "NUXT_DEBUG_BUILD=true pnpm -r run build",
    "stub": "pnpm -r run stub",
    "dev": "pnpm -C packages/cargo-deps-inspector run dev",
    "start": "pnpm -C packages/cargo-deps-inspector run start",
    "online:dev": "pnpm -C packages/cargo-deps-inspector run online:dev",
    "online:build": "pnpm -C packages/cargo-deps-inspector run online:build",
    "pages:build": "CDI_DEPLOY_TARGET=cloudflare-pages pnpm online:build",
    "prepare": "npx simple-git-hooks && pnpm -C packages/cargo-deps-inspector run dev:prepare && skills-npm",
    "lint": "pnpm -C packages/cargo-deps-inspector run dev:prepare && eslint .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "release": "bumpp -r",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@antfu/ni": "catalog:dev",
    "@antfu/utils": "catalog:inlined",
    "@axe-core/playwright": "catalog:testing",
    "@iconify-json/carbon": "catalog:icons",
    "@iconify-json/catppuccin": "catalog:icons",
    "@iconify-json/logos": "catalog:icons",
    "@iconify-json/ph": "catalog:icons",
    "@iconify-json/ri": "catalog:icons",
    "@iconify-json/simple-icons": "catalog:icons",
    "@nuxt/devtools": "catalog:dev",
    "@nuxt/eslint": "catalog:lint",
    "@playwright/test": "catalog:testing",
    "@types/d3": "catalog:types",
    "@types/d3-hierarchy": "catalog:types",
    "@typescript-eslint/utils": "catalog:lint",
    "@unocss/eslint-config": "catalog:lint",
    "ansis": "catalog:deps",
    "bumpp": "catalog:dev",
    "cargo-deps-inspector": "workspace:*",
    "cargo-deps-tools": "workspace:*",
    "devframe": "catalog:deps",
    "eslint": "catalog:lint",
    "nano-staged": "catalog:lint",
    "nuxt": "catalog:bundling",
    "nuxt-eslint-auto-explicit-import": "catalog:lint",
    "simple-git-hooks": "catalog:lint",
    "skills-npm": "catalog:dev",
    "typescript": "catalog:dev",
    "unbuild": "catalog:bundling",
    "vite": "catalog:bundling",
    "vite-plugin-inspect": "catalog:dev",
    "vitest": "catalog:testing",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm exec nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix --no-warn-ignored --no-error-on-unmatched-pattern"
  }
}
